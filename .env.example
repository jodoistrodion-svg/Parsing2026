# Telegram
API_TOKEN=replace-with-telegram-bot-token
OWNER_ID=replace-with-your-telegram-user-id

# Access
ACCESS_MODE=closed

# Commercial multi-user LZT mode
# Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=replace-with-fernet-key

# Optional legacy/global LZT credentials. Per-user credentials from Telegram take precedence.
# LZT_API_KEY=replace-with-lzt-api-key
LZT_BASE_URL=https://api.lzt.market
LZT_BALANCE_ID=20212
AUTOBUY_MODE=dry-run

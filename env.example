# Parsing2026 production configuration.
# Copy to .env and fill secrets locally. Never commit .env.

# Telegram
API_TOKEN=replace-with-telegram-bot-token
OWNER_ID=replace-with-your-telegram-user-id
OWNER_IDS=
ACCESS_MODE=closed

# LZT Market
LZT_API_KEY=replace-with-lzt-api-key
LZT_BASE_URL=https://api.lzt.market
LZT_BALANCE_ID=20212
LZT_SECRET_WORD=

# Runtime safety
AUTOBUY_MODE=live
# Legacy alias: DRY_RUN=true maps to AUTOBUY_MODE=dry-run.
TG_STARTUP_PROBE=false

# Persistence
DB_FILE=bot_data.sqlite
DB_BUSY_TIMEOUT_MS=5000
DB_CLEANUP_INTERVAL_SECONDS=3600
SEEN_RETENTION_DAYS=90
BUY_ATTEMPT_RETENTION_DAYS=180
SEED_URLS_JSON=

# Discovery
HUNTER_INTERVAL_BASE=0.02
FETCH_TIMEOUT=1.20
MAX_CONCURRENT_REQUESTS=512
DISCOVERY_MAX_IN_FLIGHT=64
MAX_ITEMS_PER_SOURCE_SCAN=200
MAX_NEW_ITEMS_PER_CYCLE=1000
NON_AUTOBUY_CYCLE_EVERY=5

# Autobuy
BUY_TIMEOUT=0.32
BUY_SEMAPHORE=128
AUTOBUY_WORKERS_PER_USER=8
AUTOBUY_QUEUE_SIZE=2500
AUTOBUY_PARALLEL_HTTP=24
AUTOBUY_BURST_FIRST_WAVE=24
AUTOBUY_MAX_DURATION_SEC=2.8
AUTOBUY_TOTAL_RETRY_WINDOW_SEC=6.0
AUTOBUY_MAX_HTTP_ATTEMPTS=0
AUTOBUY_URL_LIMIT=0
AUTOBUY_RETRY_ATTEMPTS=0

# Telegram/API pacing
TG_SEND_DELAY=0.01
SEARCH_MIN_REQUEST_INTERVAL=0.0
OTHER_MIN_REQUEST_INTERVAL=0.0
BUY_MIN_REQUEST_INTERVAL=0.0
RETRY_MAX=1
RETRY_BASE_DELAY=0.01
RETRY_MAX_DELAY=1.5

# Health/observability
HEALTH_HOST=127.0.0.1
HEALTH_PORT=0
LOG_LEVEL=INFO
LOG_FORMAT=plain
AUTOBUY_LOG_FILE=autobuy.log

# Legacy aliases accepted for migration:
# TELEGRAM_BOT_TOKEN=...
# LZT_API_TOKEN=...
# ADMIN_TELEGRAM_ID=...
